# 9Router OpenAI-compatible chat endpoint. Leave NINEROUTER_KEY blank only
# while router.studev.net has authentication disabled; otherwise create a key
# in the local gateway configuration and fill it here if required.
NINEROUTER_CHAT_URL=http://localhost:20128/v1/chat/completions
NINEROUTER_MODEL=ag/gemini-3-flash
NINEROUTER_KEY=

# QA mode: 9router (default) or gemini_api.
GEMINI_MODE=9router
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash

# No Gemini API key is required. Text vectors use local BGE-M3; visual vectors
# use SigLIP2/OpenCLIP; all remote VLM calls go through 9Router.
